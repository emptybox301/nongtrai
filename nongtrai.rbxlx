      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Lưu / tải dữ liệu người chơi bằng DataStore
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}
local profiles = {} -- [player] = data
local canSave = {} -- [player] = bool

local store
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] Không mở được DataStore:", result)
	end
end

local function defaultData()
	return {
		coins = Config.StartCoins,
		seeds = { CaRot = 3 },
		gear = {},
		crops = {},
		pets = {},
		equipped = {},
		exhibit = {},
		plots = {},
		fry = { CaRoPhi = 1 }, -- con giống thủy sản
		ponds = {}, -- trạng thái ao nuôi
		likes = 0,
		nextPetId = 1,
		luckUntil = 0,
		tutorial = 1, -- bước hướng dẫn đang làm (0 = đã xong)
		tutorialRewarded = false,
	}
end

local function reconcile(data)
	local def = defaultData()
	for k, v in pairs(def) do
		if data[k] == nil then
			data[k] = v
		end
	end
	return data
end

function DataService.load(player)
	local data, ok = nil, false
	if store then
		for _ = 1, 3 do
			local success, result = pcall(function()
				return store:GetAsync("Player_" .. player.UserId)
			end)
			if success then
				ok = true
				data = result
				break
			end
			task.wait(1)
		end
	end
	if type(data) ~= "table" then
		data = defaultData()
	end
	profiles[player] = reconcile(data)
	canSave[player] = ok
	return profiles[player], ok
end

function DataService.get(player)
	return profiles[player]
end

function DataService.save(player)
	local data = profiles[player]
	if not data or not canSave[player] or not store then
		return
	end
	local success, err = pcall(function()
		store:SetAsync("Player_" .. player.UserId, data)
	end)
	if not success then
		warn("[DataService] Lưu thất bại cho", player.Name, err)
	end
end

function DataService.release(player)
	DataService.save(player)
	profiles[player] = nil
	canSave[player] = nil
end

function DataService.all()
	return profiles
end

-- tự lưu mỗi 2 phút
task.spawn(function()
	while true do
		task.wait(120)
		for player in pairs(profiles) do
			task.spawn(DataService.save, player)
		end
	end
end)

game:BindToClose(function()
	for player in pairs(profiles) do
		DataService.save(player)
	end
end)

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="8">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- NÔNG TRẠI NGŨ HÀNH - Server chính
-- Nông trại, cửa hàng, pet ngũ hành, hợp thể, nhà triển lãm

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local PetUtil = require(Shared.PetUtil)
local DataService = require(script.Parent.DataService)
local WorldBuilder = require(script.Parent.WorldBuilder)
local Visuals = require(script.Parent.Visuals)

----------------------------------------------------------------
-- REMOTES
----------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local DataEvent = Instance.new("RemoteEvent")
DataEvent.Name = "Data"
DataEvent.Parent = remotes
local NotifyEvent = Instance.new("RemoteEvent")
NotifyEvent.Name = "Notify"
NotifyEvent.Parent = remotes
local Request = Instance.new("RemoteFunction")
Request.Name = "Request"
Request.Parent = remotes
remotes.Parent = ReplicatedStorage

----------------------------------------------------------------
-- TRẠNG THÁI
----------------------------------------------------------------
local plots, sections = WorldBuilder.build()
local petFolder = Instance.new("Folder")
petFolder.Name = "Pets"
petFolder.Parent = workspace

local playerPlot = {} -- [player] = plot
local selected = {} -- [player] = { kind, key }
local bought = {} -- [player] = { [seedKey/fishKey] = n }
local waveStock = {}
local restockAt = 0
local petModels = {} -- [player] = { model, ... }
local exhibitModels = {} -- [sectionIndex] = { model, ... }
local likeCooldown = {} -- ["liker:owner"] = os.time()

local function notify(player, text, kind)
	NotifyEvent:FireClient(player, text, kind or "info")
end

local function stockFor(player)
	local out = {}
	local b = bought[player] or {}
	for key, n in pairs(waveStock) do
		out[key] = math.max(0, n - (b[key] or 0))
	end
	return out
end

local function push(player)
	local data = DataService.get(player)
	if not data then
		return
	end
	local plot = playerPlot[player]
	DataEvent:FireClient(player, {
		data = data,
		stock = stockFor(player),
		restockAt = restockAt,
		selected = selected[player],
		plotIndex = plot and plot.index or nil,
	})
end

local function buffsOf(data)
	return PetUtil.totalBuffs(data)
end

----------------------------------------------------------------
-- CỬA HÀNG HẠT GIỐNG: LÀM MỚI
----------------------------------------------------------------
local function restock()
	for _, key in ipairs(Config.SeedOrder) do
		local s = Config.Seeds[key]
		if math.random() <= s.appear then
			waveStock[key] = math.random(s.stock[1], s.stock[2])
		else
			waveStock[key] = 0
		end
	end
	for _, key in ipairs(Config.FishOrder) do
		local f = Config.Fish[key]
		if math.random() <= f.appear then
			waveStock[key] = math.random(f.stock[1], f.stock[2])
		else
			waveStock[key] = 0
		end
	end
	waveStock.CaRot = math.max(waveStock.CaRot, 5)
	waveStock.CaRoPhi = math.max(waveStock.CaRoPhi, 3)
	bought = {}
	restockAt = os.time() + Config.RestockSeconds
	for _, p in ipairs(Players:GetPlayers()) do
		push(p)
		notify(p, "🌱🐟 Cửa hàng hạt giống & thủy sản vừa nhập hàng mới!", "info")
	end
end

----------------------------------------------------------------
-- NÔNG TRẠI
----------------------------------------------------------------
local function tileKey(idx)
	return "t" .. idx
end

local function progressOf(plant)
	return math.clamp((os.time() - plant.at) / plant.grow, 0, 1)
end

local function updateTileVisual(plot, idx, plant)
	local tile = plot.tiles[idx]
	if not tile.label then
		tile.label = Visuals.billboard(tile.soil, "", Color3.new(1, 1, 1), 4)
		tile.label.Parent.MaxDistance = 40
	end
	if not plant then
		if tile.visual then
			tile.visual.model:Destroy()
			tile.visual = nil
		end
		tile.label.Text = ""
		return
	end
	local prog = progressOf(plant)
	local stage = math.floor(prog * 10)
	if not tile.visual or tile.visual.stage ~= stage or tile.visual.seed ~= plant.seed then
		if tile.visual then
			tile.visual.model:Destroy()
		end
		local shownMut = prog >= 1 and plant.mut or nil
		local model = Visuals.makeCrop(plant.seed, shownMut, 0.3 + 0.7 * prog)
		local fruitSize = model.PrimaryPart.Size.Y
		local stemH = 0.6 + prog * 1.2
		Visuals.part({
			Name = "Stem",
			Size = Vector3.new(0.3, stemH, 0.3),
			Color = Color3.fromRGB(70, 150, 60),
			CFrame = CFrame.new(0, -fruitSize / 2 - stemH / 2 + 0.2, 0),
			Parent = model,
		})
		model:PivotTo(tile.soil.CFrame * CFrame.new(0, 0.5 + stemH + fruitSize / 2 - 0.2, 0))
		model.Parent = tile.model
		tile.visual = { model = model, stage = stage, seed = plant.seed }
	end
	if prog >= 1 then
		local name = PetUtil.cropName(plant.seed .. "|" .. (plant.mut or "Thuong"))
		tile.label.Text = "✨ " .. name .. " - Sẵn sàng!"
		tile.label.TextColor3 = Color3.fromRGB(255, 240, 120)
	else
		local remaining = plant.grow - (os.time() - plant.at)
		tile.label.Text = Config.Seeds[plant.seed].name .. " " .. PetUtil.formatTime(remaining) .. (plant.fert and " 🌿" or "")
		tile.label.TextColor3 = Color3.new(1, 1, 1)
	end
end

local updatePondVisual -- khai báo trước, định nghĩa ở phần AO NUÔI

local function refreshPlot(plot)
	local data = plot.owner and DataService.get(plot.owner)
	for idx = 1, WorldBuilder.GRID_SIZE do
		updateTileVisual(plot, idx, data and data.plots[tileKey(idx)] or nil)
	end
	for idx = 1, Config.PondCount do
		updatePondVisual(plot, idx, data and data.ponds["p" .. idx] or nil)
	end
end

local function rollMutation(data, buffs)
	local luck = 1 + buffs.Hoa
	if data.luckUntil > os.time() then
		luck *= 2
	end
	for _, m in ipairs(Config.Mutations) do
		if math.random() < m.chance * luck then
			return m.key
		end
	end
	return nil
end

local function consumeSelected(player, data, kind, key)
	local bag = (kind == "seed" and data.seeds) or (kind == "fry" and data.fry) or data.gear
	bag[key] = (bag[key] or 0) - 1
	if bag[key] <= 0 then
		bag[key] = nil
		selected[player] = nil
	end
end

local function harvest(player, data, idx, plant)
	local buffs = buffsOf(data)
	local amount = plant.fert and 2 or 1
	local extra = {}
	if math.random() < buffs.Thuy then
		amount *= 2
		table.insert(extra, "💧 x2")
	end
	local key = plant.seed .. "|" .. (plant.mut or "Thuong")
	data.crops[key] = (data.crops[key] or 0) + amount
	if math.random() < buffs.Tho then
		data.seeds[plant.seed] = (data.seeds[plant.seed] or 0) + 1
		table.insert(extra, "🪨 hoàn hạt")
	end
	data.plots[tileKey(idx)] = nil
	local msg = string.format("Thu hoạch %d %s", amount, PetUtil.cropName(key))
	if #extra > 0 then
		msg ..= " (" .. table.concat(extra, ", ") .. ")"
	end
	notify(player, msg, plant.mut and "rare" or "success")
end

local function onTileClicked(player, plot, idx)
	if plot.owner ~= player then
		notify(player, "Đây không phải nông trại của bạn!", "error")
		return
	end
	local data = DataService.get(player)
	if not data then
		return
	end
	local key = tileKey(idx)
	local plant = data.plots[key]
	local sel = selected[player]

	if not plant then
		if sel and sel.kind == "seed" and (data.seeds[sel.key] or 0) > 0 then
			local seed = Config.Seeds[sel.key]
			local buffs = buffsOf(data)
			data.plots[key] = {
				seed = sel.key,
				at = os.time(),
				grow = math.max(5, math.floor(seed.grow / (1 + buffs.Moc))),
				mut = rollMutation(data, buffs),
				fert = false,
			}
			consumeSelected(player, data, "seed", sel.key)
		else
			notify(player, "Chọn hạt giống ở thanh bên dưới rồi chạm vào ô đất để trồng", "info")
			return
		end
	else
		local ready = progressOf(plant) >= 1
		if sel and sel.kind == "gear" and sel.key == "Xeng" then
			data.plots[key] = nil
			notify(player, "Đã nhổ bỏ cây", "info")
		elseif sel and sel.kind == "gear" and sel.key == "BinhTuoi" and not ready and (data.gear.BinhTuoi or 0) > 0 then
			local remaining = plant.grow - (os.time() - plant.at)
			plant.at -= math.ceil(remaining * 0.25)
			consumeSelected(player, data, "gear", "BinhTuoi")
			notify(player, "💧 Đã tưới cây!", "success")
		elseif sel and sel.kind == "gear" and sel.key == "PhanBon" and not plant.fert and (data.gear.PhanBon or 0) > 0 then
			plant.fert = true
			consumeSelected(player, data, "gear", "PhanBon")
			notify(player, "🌿 Đã bón phân: sản lượng x2!", "success")
		elseif ready then
			harvest(player, data, idx, plant)
		else
			notify(player, "Cây còn " .. PetUtil.formatTime(plant.grow - (os.time() - plant.at)) .. " nữa mới chín", "info")
			return
		end
	end
	updateTileVisual(plot, idx, data.plots[key])
	push(player)
end

for _, plot in ipairs(plots) do
	for idx, tile in ipairs(plot.tiles) do
		tile.click.MouseClick:Connect(function(player)
			onTileClicked(player, plot, idx)
		end)
	end
end

----------------------------------------------------------------
-- AO NUÔI THỦY SẢN
----------------------------------------------------------------
local function pondGrowTime(data, fishKey)
	local buffs = buffsOf(data)
	return math.max(5, math.floor(Config.Fish[fishKey].grow / (1 + buffs.Thuy)))
end

updatePondVisual = function(plot, idx, pond)
	local p = plot.ponds[idx]
	if not p.label then
		p.label = Visuals.billboard(p.rim, "", Color3.new(1, 1, 1), 4)
		p.label.Parent.MaxDistance = 45
	end
	if not pond then
		if p.visual then
			for _, m in ipairs(p.visual.models) do
				m:Destroy()
			end
			p.visual = nil
		end
		p.water.Color = Color3.fromRGB(70, 150, 200)
		p.label.Text = plot.owner and "Ao trống" or ""
		p.label.TextColor3 = Color3.fromRGB(200, 230, 255)
		return
	end
	local prog = progressOf(pond)
	local stage = math.floor(prog * 4)
	if not p.visual or p.visual.stage ~= stage or p.visual.fish ~= pond.fish then
		if p.visual then
			for _, m in ipairs(p.visual.models) do
				m:Destroy()
			end
		end
		local models = {}
		local shownMut = prog >= 1 and pond.mut or nil
		local count = 3
		for k = 1, count do
			local m = Visuals.makeFish(pond.fish, shownMut, 0.45 + 0.75 * prog)
			local angle = (k / count) * math.pi * 2
			m:PivotTo(p.water.CFrame * CFrame.new(math.cos(angle) * 2.6, 0.6, math.sin(angle) * 2.6) * CFrame.Angles(0, -angle, 0))
			m.Parent = p.model
			table.insert(models, m)
		end
		p.visual = { models = models, stage = stage, fish = pond.fish }
	end
	local info = Config.Fish[pond.fish]
	if prog >= 1 then
		p.water.Color = Color3.fromRGB(90, 200, 220)
		p.label.Text = "✨ " .. PetUtil.cropName(pond.fish .. "|" .. (pond.mut or "Thuong")) .. " - Thu hoạch!"
		p.label.TextColor3 = Color3.fromRGB(255, 240, 120)
	else
		p.water.Color = Color3.fromRGB(70, 150, 200)
		local remaining = pond.grow - (os.time() - pond.at)
		p.label.Text = info.name .. " " .. PetUtil.formatTime(remaining) .. ((pond.fed or 0) > 0 and (" 🍤x" .. pond.fed) or "")
		p.label.TextColor3 = Color3.new(1, 1, 1)
	end
end

local function harvestPond(player, data, idx, pond)
	local buffs = buffsOf(data)
	local info = Config.Fish[pond.fish]
	local amount = math.random(info.yield[1], info.yield[2]) + (pond.fed or 0)
	local extra = {}
	if math.random() < buffs.Thuy then
		amount *= 2
		table.insert(extra, "💧 x2")
	end
	local key = pond.fish .. "|" .. (pond.mut or "Thuong")
	data.crops[key] = (data.crops[key] or 0) + amount
	if math.random() < buffs.Tho then
		data.fry[pond.fish] = (data.fry[pond.fish] or 0) + 1
		table.insert(extra, "🪨 hoàn con giống")
	end
	data.ponds["p" .. idx] = nil
	local msg = string.format("Thu hoạch %d %s", amount, PetUtil.cropName(key))
	if #extra > 0 then
		msg ..= " (" .. table.concat(extra, ", ") .. ")"
	end
	notify(player, msg, pond.mut and "rare" or "success")
end

local function onPondClicked(player, plot, idx)
	if plot.owner ~= player then
		notify(player, "Đây không phải ao của bạn!", "error")
		return
	end
	local data = DataService.get(player)
	if not data then
		return
	end
	local key = "p" .. idx
	local pond = data.ponds[key]
	local sel = selected[player]
	if not pond then
		if sel and sel.kind == "fry" and (data.fry[sel.key] or 0) > 0 then
			data.ponds[key] = {
				fish = sel.key,
				at = os.time(),
				grow = pondGrowTime(data, sel.key),
				mut = rollMutation(data, buffsOf(data)),
				fed = 0,
			}
			consumeSelected(player, data, "fry", sel.key)
			notify(player, "🐟 Đã thả " .. Config.Fish[sel.key].name .. " xuống ao", "success")
		else
			notify(player, "Chọn con giống (mua ở quầy 🐟 Thủy Sản) rồi chạm vào ao để thả", "info")
			return
		end
	else
		local ready = progressOf(pond) >= 1
		if sel and sel.kind == "gear" and sel.key == "Xeng" then
			data.ponds[key] = nil
			notify(player, "Đã xả ao", "info")
		elseif sel and sel.kind == "gear" and sel.key == "ThucAnCa" and not ready and (data.gear.ThucAnCa or 0) > 0 then
			if (pond.fed or 0) >= 3 then
				notify(player, "Ao này đã cho ăn đủ 3 lần rồi", "error")
				return
			end
			local remaining = pond.grow - (os.time() - pond.at)
			pond.at -= math.ceil(remaining * 0.3)
			pond.fed = (pond.fed or 0) + 1
			consumeSelected(player, data, "gear", "ThucAnCa")
			notify(player, "🍤 Đã cho cá ăn! (+1 con khi thu hoạch)", "success")
		elseif ready then
			harvestPond(player, data, idx, pond)
		else
			notify(player, "Còn " .. PetUtil.formatTime(pond.grow - (os.time() - pond.at)) .. " nữa mới thu hoạch được", "info")
			return
		end
	end
	updatePondVisual(plot, idx, data.ponds[key])
	push(player)
end

for _, plot in ipairs(plots) do
	for idx, p in ipairs(plot.ponds) do
		p.click.MouseClick:Connect(function(player)
			onPondClicked(player, plot, idx)
		end)
	end
end

----------------------------------------------------------------
-- PET THEO NGƯỜI CHƠI
----------------------------------------------------------------
local function refreshPets(player)
	for _, m in ipairs(petModels[player] or {}) do
		m:Destroy()
	end
	petModels[player] = {}
	local data = DataService.get(player)
	if not data then
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	for _, id in ipairs(data.equipped) do
		local pet = data.pets[id]
		if pet then
			local model = Visuals.makePet(pet, nil)
			if hrp then
				model:PivotTo(hrp.CFrame * CFrame.new(0, 2, 5))
			end
			model.Parent = petFolder
			table.insert(petModels[player], model)
		end
	end
end

RunService.Heartbeat:Connect(function(dt)
	local t = os.clock()
	for player, list in pairs(petModels) do
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			for i, model in ipairs(list) do
				local angle = (i - 2) * 0.9
				local offset = CFrame.new(math.sin(angle) * 5, 1 + math.sin(t * 3 + i) * 0.4, 4 + math.cos(angle) * 1.5)
				local target = hrp.CFrame * offset
				model:PivotTo(model:GetPivot():Lerp(target, math.min(1, dt * 6)))
			end
		end
	end
end)

----------------------------------------------------------------
-- NHÀ TRIỂN LÃM
----------------------------------------------------------------
local function exhibitCount(data)
	local n = 0
	for i = 1, Config.ExhibitSlots do
		if data.exhibit["s" .. i] then
			n += 1
		end
	end
	return n
end

local function exhibitIncome(data)
	local total = 0
	for i = 1, Config.ExhibitSlots do
		local item = data.exhibit["s" .. i]
		if item then
			if item.kind == "pet" and data.pets[item.id] then
				total += PetUtil.petExhibitValue(data.pets[item.id])
			elseif item.kind == "crop" then
				total += PetUtil.cropExhibitValue(item.key)
			end
		end
	end
	return total
end

local function isExhibited(data, petId)
	for i = 1, Config.ExhibitSlots do
		local item = data.exhibit["s" .. i]
		if item and item.kind == "pet" and item.id == petId then
			return true
		end
	end
	return false
end

local exhibitFolder = Instance.new("Folder")
exhibitFolder.Name = "ExhibitItems"
exhibitFolder.Parent = workspace

-- Mỗi nông trại (plot.index) sở hữu 1 khu trong Nhà Triển Lãm chung
local function refreshExhibit(plot)
	local section = sections[plot.index]
	for _, m in ipairs(exhibitModels[plot.index] or {}) do
		m:Destroy()
	end
	exhibitModels[plot.index] = {}
	local owner = plot.owner
	local data = owner and DataService.get(owner)
	if not data then
		section.nameLabel.Text = "Khu " .. plot.index .. " • trống"
		section.likeLabel.Text = "❤ 0"
		return
	end
	section.nameLabel.Text = "Khu của " .. owner.DisplayName
	section.likeLabel.Text = "❤ " .. PetUtil.formatNumber(data.likes)
	for i = 1, Config.ExhibitSlots do
		local item = data.exhibit["s" .. i]
		local model
		if item and item.kind == "pet" and data.pets[item.id] then
			model = Visuals.makePet(data.pets[item.id], nil)
		elseif item and item.kind == "crop" then
			local seedKey, mutKey = string.match(item.key, "^([^|]+)|(.+)$")
			if seedKey and PetUtil.produceInfo(seedKey) then
				model = Visuals.makeCrop(seedKey, mutKey, 1.4)
				Visuals.billboard(model.PrimaryPart, PetUtil.cropName(item.key), Color3.fromRGB(255, 240, 180), 2.5)
			end
		end
		if model then
			local ped = section.pedestals[i]
			model:PivotTo(ped.CFrame * CFrame.new(0, 1.5 + model.PrimaryPart.Size.Y / 2 + 0.3, 0))
			model.Parent = exhibitFolder
			table.insert(exhibitModels[plot.index], model)
		end
	end
end

for _, plot in ipairs(plots) do
	local section = sections[plot.index]
	section.likePrompt.Triggered:Connect(function(player)
		local owner = plot.owner
		if not owner then
			notify(player, "Khu trưng bày này chưa có chủ", "info")
			return
		end
		if owner == player then
			notify(player, "Đây là khu của bạn! Mời bạn bè đến thích nhé", "info")
			return
		end
		local ownerData = DataService.get(owner)
		local likerData = DataService.get(player)
		if not ownerData or not likerData then
			return
		end
		if exhibitCount(ownerData) == 0 then
			notify(player, "Triển lãm đang trống", "info")
			return
		end
		local key = player.UserId .. ":" .. owner.UserId
		local last = likeCooldown[key]
		if last and os.time() - last < Config.LikeCooldown then
			notify(player, "Bạn vừa thích rồi, quay lại sau " .. PetUtil.formatTime(Config.LikeCooldown - (os.time() - last)), "error")
			return
		end
		likeCooldown[key] = os.time()
		local reward = 50 + 10 * exhibitCount(ownerData)
		ownerData.likes += 1
		ownerData.coins += reward
		likerData.coins += 10
		notify(owner, "❤ " .. player.DisplayName .. " đã thích khu trưng bày của bạn! +" .. reward .. " xu", "rare")
		notify(player, "Bạn đã thích triển lãm của " .. owner.DisplayName .. " (+10 xu)", "success")
		section.likeLabel.Text = "❤ " .. PetUtil.formatNumber(ownerData.likes)
		push(owner)
		push(player)
	end)
end

task.spawn(function()
	while true do
		task.wait(Config.ExhibitIncomeInterval)
		for player, plot in pairs(playerPlot) do
			local data = DataService.get(player)
			if data and plot then
				local income = exhibitIncome(data)
				if income > 0 then
					data.coins += income
					notify(player, "🏛 Triển lãm mang về +" .. PetUtil.formatNumber(income) .. " xu", "success")
					push(player)
				end
			end
		end
	end
end)

----------------------------------------------------------------
-- XỬ LÝ YÊU CẦU TỪ CLIENT
----------------------------------------------------------------
local function isEquipped(data, id)
	return table.find(data.equipped, id) ~= nil
end

local Actions = {}

function Actions.Hello(player)
	push(player)
	return true
end

function Actions.Select(player, data, kind, key)
	if kind == nil then
		selected[player] = nil
		return true
	end
	if kind == "seed" and Config.Seeds[key] and (data.seeds[key] or 0) > 0 then
		selected[player] = { kind = "seed", key = key }
		return true
	elseif kind == "fry" and Config.Fish[key] and (data.fry[key] or 0) > 0 then
		selected[player] = { kind = "fry", key = key }
		return true
	elseif kind == "gear" and Config.Gear[key] and Config.Gear[key].selectable and (data.gear[key] or 0) > 0 then
		selected[player] = { kind = "gear", key = key }
		return true
	end
	return false, "Không thể chọn vật phẩm này"
end

function Actions.BuyFry(player, data, key)
	local fish = Config.Fish[key]
	if not fish then
		return false, "Con giống không tồn tại"
	end
	if (stockFor(player)[key] or 0) <= 0 then
		return false, "Hết hàng! Đợi lần nhập hàng sau"
	end
	if data.coins < fish.price then
		return false, "Không đủ xu"
	end
	data.coins -= fish.price
	data.fry[key] = (data.fry[key] or 0) + 1
	bought[player] = bought[player] or {}
	bought[player][key] = (bought[player][key] or 0) + 1
	return true, "Đã mua 1 con giống " .. fish.name
end

function Actions.BuySeed(player, data, key)
	local seed = Config.Seeds[key]
	if not seed then
		return false, "Hạt không tồn tại"
	end
	if (stockFor(player)[key] or 0) <= 0 then
		return false, "Hết hàng! Đợi lần nhập hàng sau"
	end
	if data.coins < seed.price then
		return false, "Không đủ xu"
	end
	data.coins -= seed.price
	data.seeds[key] = (data.seeds[key] or 0) + 1
	bought[player] = bought[player] or {}
	bought[player][key] = (bought[player][key] or 0) + 1
	return true, "Đã mua 1 hạt " .. seed.name
end

function Actions.BuyGear(player, data, key)
	local gear = Config.Gear[key]
	if not gear then
		return false, "Vật phẩm không tồn tại"
	end
	if gear.reusable and (data.gear[key] or 0) > 0 then
		return false, "Bạn đã có " .. gear.name .. " rồi"
	end
	if data.coins < gear.price then
		return false, "Không đủ xu"
	end
	data.coins -= gear.price
	data.gear[key] = (data.gear[key] or 0) + 1
	return true, "Đã mua " .. gear.name
end

local function newPet(data, els, tier, syn)
	local id = "p" .. data.nextPetId
	data.nextPetId += 1
	data.pets[id] = { id = id, els = els, tier = tier, syn = syn or false }
	return data.pets[id]
end

function Actions.BuyPet(player, data, element)
	if not Config.Elements[element] then
		return false, "Pet không tồn tại"
	end
	if data.coins < Config.BasicPetPrice then
		return false, "Không đủ xu"
	end
	data.coins -= Config.BasicPetPrice
	local pet = newPet(data, { element }, 1, false)
	if #data.equipped < Config.MaxEquippedPets then
		table.insert(data.equipped, pet.id)
		refreshPets(player)
	end
	return true, "Đã mua " .. PetUtil.petName(pet) .. "!"
end

local function sellPrice(data, key)
	return math.floor(PetUtil.cropValue(key) * (1 + buffsOf(data).Kim))
end

function Actions.SellCrop(player, data, key)
	local n = data.crops[key] or 0
	if n <= 0 then
		return false, "Không có nông sản này"
	end
	local total = sellPrice(data, key) * n
	data.crops[key] = nil
	data.coins += total
	return true, "Bán được " .. PetUtil.formatNumber(total) .. " xu"
end

function Actions.SellAll(player, data)
	local total = 0
	for key, n in pairs(data.crops) do
		total += sellPrice(data, key) * n
	end
	if total <= 0 then
		return false, "Túi không có nông sản"
	end
	data.crops = {}
	data.coins += total
	return true, "Bán tất cả được " .. PetUtil.formatNumber(total) .. " xu"
end

function Actions.Equip(player, data, id)
	if not data.pets[id] then
		return false, "Pet không tồn tại"
	end
	if isEquipped(data, id) then
		return false, "Pet đã được trang bị"
	end
	if isExhibited(data, id) then
		return false, "Pet đang được trưng bày"
	end
	if #data.equipped >= Config.MaxEquippedPets then
		return false, "Chỉ trang bị tối đa " .. Config.MaxEquippedPets .. " pet"
	end
	table.insert(data.equipped, id)
	refreshPets(player)
	return true
end

function Actions.Unequip(player, data, id)
	local i = table.find(data.equipped, id)
	if not i then
		return false
	end
	table.remove(data.equipped, i)
	refreshPets(player)
	return true
end

function Actions.Fuse(player, data, idA, idB)
	local a, b = data.pets[idA], data.pets[idB]
	if not a or not b or idA == idB then
		return false, "Chọn 2 pet khác nhau"
	end
	for _, id in ipairs({ idA, idB }) do
		if isEquipped(data, id) or isExhibited(data, id) then
			return false, "Hãy gỡ pet khỏi trang bị / triển lãm trước khi hợp thể"
		end
	end
	local result, reason = PetUtil.previewFusion(a, b)
	if not result then
		return false, reason
	end
	if (data.gear.ManhHopThe or 0) < result.shardCost then
		return false, "Cần " .. result.shardCost .. " Mảnh Hợp Thể (mua ở Cửa hàng Dụng cụ)"
	end
	data.gear.ManhHopThe -= result.shardCost
	if data.gear.ManhHopThe <= 0 then
		data.gear.ManhHopThe = nil
	end
	if math.random() > result.chance then
		return false, "💥 Tương khắc! Hợp thể thất bại, mất " .. result.shardCost .. " mảnh (pet vẫn còn)"
	end
	data.pets[idA] = nil
	data.pets[idB] = nil
	local pet = newPet(data, result.els, result.tier, result.syn)
	notify(player, "✨ Hợp thể thành công: " .. PetUtil.petName(pet) .. " [" .. PetUtil.tierInfo(pet.tier).name .. "]", "rare")
	return true
end

function Actions.Exhibit(player, data, kind, idOrKey)
	local slot
	for i = 1, Config.ExhibitSlots do
		if not data.exhibit["s" .. i] then
			slot = "s" .. i
			break
		end
	end
	if not slot then
		return false, "Nhà triển lãm đã đầy"
	end
	if kind == "pet" then
		if not data.pets[idOrKey] then
			return false, "Pet không tồn tại"
		end
		if isEquipped(data, idOrKey) or isExhibited(data, idOrKey) then
			return false, "Pet đang được dùng"
		end
		data.exhibit[slot] = { kind = "pet", id = idOrKey }
	elseif kind == "crop" then
		if (data.crops[idOrKey] or 0) <= 0 then
			return false, "Không có nông sản này"
		end
		data.crops[idOrKey] -= 1
		if data.crops[idOrKey] <= 0 then
			data.crops[idOrKey] = nil
		end
		data.exhibit[slot] = { kind = "crop", key = idOrKey }
	else
		return false
	end
	local plot = playerPlot[player]
	if plot then
		refreshExhibit(plot)
	end
	return true, "Đã đưa vào nhà triển lãm"
end

function Actions.Unexhibit(player, data, slotIndex)
	local slot = "s" .. tostring(slotIndex)
	local item = data.exhibit[slot]
	if not item then
		return false
	end
	if item.kind == "crop" then
		data.crops[item.key] = (data.crops[item.key] or 0) + 1
	end
	data.exhibit[slot] = nil
	local plot = playerPlot[player]
	if plot then
		refreshExhibit(plot)
	end
	return true, "Đã gỡ khỏi triển lãm"
end

function Actions.SetTutorial(player, data, n, completed)
	if type(n) ~= "number" then
		return false
	end
	n = math.clamp(math.floor(n), 0, 50)
	data.tutorial = n
	if n == 0 and completed == true and not data.tutorialRewarded then
		data.tutorialRewarded = true
		data.coins += Config.TutorialReward
		notify(player, "🎉 Hoàn thành hướng dẫn! +" .. Config.TutorialReward .. " xu", "rare")
	end
	return true
end

function Actions.UseLuck(player, data)
	if (data.gear.BuaMayMan or 0) <= 0 then
		return false, "Bạn không có Bùa May Mắn"
	end
	data.gear.BuaMayMan -= 1
	if data.gear.BuaMayMan <= 0 then
		data.gear.BuaMayMan = nil
	end
	data.luckUntil = math.max(data.luckUntil, os.time()) + Config.LuckCharmSeconds
	return true, "🍀 May mắn x2 trong " .. math.floor(Config.LuckCharmSeconds / 60) .. " phút!"
end

local lastRequest = {}
Request.OnServerInvoke = function(player, action, ...)
	if type(action) ~= "string" or not Actions[action] then
		return false, "Yêu cầu không hợp lệ"
	end
	local now = os.clock()
	if lastRequest[player] and now - lastRequest[player] < 0.08 then
		return false, "Thao tác quá nhanh"
	end
	lastRequest[player] = now
	if action == "Hello" then
		return Actions.Hello(player)
	end
	local data = DataService.get(player)
	if not data then
		return false, "Dữ liệu chưa sẵn sàng"
	end
	local ok, a, b = pcall(Actions[action], player, data, ...)
	if not ok then
		warn("[Request]", action, a)
		return false, "Lỗi máy chủ"
	end
	push(player)
	return a, b
end

----------------------------------------------------------------
-- VÀO / RỜI GAME
----------------------------------------------------------------
-- Giữ chỗ 1 nông trại trống ngay khi vào (trước khi tải dữ liệu)
local function reservePlot(player)
	for _, plot in ipairs(plots) do
		if not plot.owner then
			plot.owner = player
			playerPlot[player] = plot
			return plot
		end
	end
	return nil
end

local function activatePlot(player, plot)
	plot.ownerLabel.Text = "🌾 Nông trại của " .. player.DisplayName
	refreshPlot(plot)
	refreshExhibit(plot)
end

-- Chuyển dữ liệu cũ sang phiên bản mới (triển lãm 6 bục riêng → 3 bục trong nhà chung)
local function migrateData(data)
	for i = Config.ExhibitSlots + 1, 10 do
		local item = data.exhibit["s" .. i]
		if item then
			if item.kind == "crop" then
				data.crops[item.key] = (data.crops[item.key] or 0) + 1
			end
			data.exhibit["s" .. i] = nil
		end
	end
end

local function onCharacter(player, char)
	local plot = playerPlot[player]
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	if plot and hrp then
		task.wait(0.1)
		char:PivotTo(plot.spawnCFrame)
	end
	refreshPets(player)
end

Players.PlayerAdded:Connect(function(player)
	local plot = reservePlot(player)
	if not plot or #Players:GetPlayers() > Config.MaxPlayers then
		if plot then
			plot.owner = nil
			playerPlot[player] = nil
		end
		player:Kick("Server đã đủ " .. Config.MaxPlayers .. " người chơi. Hãy vào server khác nhé!")
		return
	end
	local data, ok = DataService.load(player)
	if not player.Parent then
		DataService.release(player)
		return
	end
	migrateData(data)
	if not ok then
		task.delay(5, function()
			if player.Parent then
				notify(player, "⚠ Không tải được dữ liệu lưu. Tiến trình lần này sẽ KHÔNG được lưu (trong Studio hãy bật API Services).", "error")
			end
		end)
	end
	activatePlot(player, plot)
	player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)
	if player.Character then
		onCharacter(player, player.Character)
	end
	push(player)
end)

Players.PlayerRemoving:Connect(function(player)
	local plot = playerPlot[player]
	for _, m in ipairs(petModels[player] or {}) do
		m:Destroy()
	end
	petModels[player] = nil
	selected[player] = nil
	bought[player] = nil
	lastRequest[player] = nil
	DataService.release(player)
	if plot then
		plot.owner = nil
		playerPlot[player] = nil
		plot.ownerLabel.Text = "Nông trại trống"
		refreshPlot(plot)
		refreshExhibit(plot)
	end
end)

----------------------------------------------------------------
-- VÒNG LẶP CHÍNH
----------------------------------------------------------------
restock()
task.spawn(function()
	while true do
		task.wait(1)
		if os.time() >= restockAt then
			restock()
		end
		for _, plot in ipairs(plots) do
			if plot.owner then
				refreshPlot(plot)
			end
		end
	end
end)

print("[Nông Trại Ngũ Hành] Server đã sẵn sàng!")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Visuals</string>
          <string name="Source"><![CDATA[-- Tạo mô hình 3D cho pet và nông sản (dựng bằng Part, không cần asset)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local PetUtil = require(ReplicatedStorage.Shared.PetUtil)

local Visuals = {}

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	p.Parent = props.Parent
	return p
end

local function billboard(adornee, text, color, offsetY)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(160, 40)
	bb.StudsOffset = Vector3.new(0, offsetY, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 60
	bb.Adornee = adornee
	bb.Parent = adornee
	local lbl = Instance.new("TextLabel")
	lbl.Name = "Label"
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.TextColor3 = color
	lbl.TextStrokeTransparency = 0.3
	lbl.TextScaled = true
	lbl.Font = Enum.Font.FredokaOne
	lbl.Text = text
	lbl.Parent = bb
	return lbl
end

function Visuals.makePet(pet, ownerName)
	local model = Instance.new("Model")
	model.Name = "Pet"
	local main = Config.Elements[pet.els[1]].color
	local size = 1.6 + pet.tier * 0.35
	local body = part({ Name = "Body", Shape = Enum.PartType.Ball, Size = Vector3.one * size, Color = main, Material = Enum.Material.SmoothPlastic, CFrame = CFrame.new(), Parent = model })
	-- tai
	for _, side in ipairs({ -1, 1 }) do
		part({ Name = "Ear", Size = Vector3.new(size * 0.22, size * 0.45, size * 0.22), Color = main, CFrame = CFrame.new(side * size * 0.28, size * 0.5, 0) * CFrame.Angles(0, 0, -side * 0.3), Parent = model })
		part({ Name = "Eye", Shape = Enum.PartType.Ball, Size = Vector3.one * size * 0.18, Color = Color3.new(0.1, 0.1, 0.1), CFrame = CFrame.new(side * size * 0.2, size * 0.1, -size * 0.45), Parent = model })
	end
	-- quả cầu nguyên tố quay quanh cho pet đa hệ
	for i = 2, #pet.els do
		local angle = (i - 2) / math.max(1, #pet.els - 1) * math.pi * 2
		part({
			Name = "Orb",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * size * 0.3,
			Color = Config.Elements[pet.els[i]].color,
			Material = Enum.Material.Neon,
			CFrame = CFrame.new(math.cos(angle) * size * 0.8, size * 0.35, math.sin(angle) * size * 0.8),
			Parent = model,
		})
	end
	if pet.tier >= 3 then
		local light = Instance.new("PointLight")
		light.Color = PetUtil.tierInfo(pet.tier).color
		light.Range = 6 + pet.tier
		light.Brightness = 1.5
		light.Parent = body
	end
	if pet.tier >= 4 or pet.syn then
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparkle.Color = ColorSequence.new(PetUtil.tierInfo(pet.tier).color)
		sparkle.Size = NumberSequence.new(0.3)
		sparkle.Rate = pet.tier * 2
		sparkle.Lifetime = NumberRange.new(0.8, 1.2)
		sparkle.Speed = NumberRange.new(0.5, 1)
		sparkle.SpreadAngle = Vector2.new(180, 180)
		sparkle.Parent = body
	end
	local title = PetUtil.petName(pet) .. " [" .. PetUtil.tierInfo(pet.tier).name .. "]"
	if ownerName then
		title = title .. "\n" .. ownerName
	end
	billboard(body, title, PetUtil.tierInfo(pet.tier).color, size * 0.5 + 1.2)
	model.PrimaryPart = body
	return model
end

local function mutationLook(baseColor, mutKey)
	local color, material, sizeMult = baseColor, Enum.Material.SmoothPlastic, 1
	for _, m in ipairs(Config.Mutations) do
		if m.key == mutKey then
			if m.color then
				color = m.color
				material = Enum.Material.Neon
			end
			if m.key == "KhongLo" then
				sizeMult = 1.6
			end
		end
	end
	return color, material, sizeMult
end

local function ovalPart(props, scale)
	local p = part(props)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = scale or Vector3.one
	mesh.Parent = p
	return p
end

-- Thủy sản: cá / tôm / cua dựng bằng Part
function Visuals.makeFish(fishKey, mutKey, scale)
	local fish = Config.Fish[fishKey]
	local color, material, sizeMult = mutationLook(fish.color, mutKey)
	local s = scale * sizeMult
	local model = Instance.new("Model")
	model.Name = "Fish"
	local body
	if fish.shape == "crab" then
		body = ovalPart({ Name = "Body", Size = Vector3.new(2.2, 0.9, 1.6) * s, Color = color, Material = material, CFrame = CFrame.new(), Parent = model })
		for _, side in ipairs({ -1, 1 }) do
			part({ Name = "Claw", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.8 * s, Color = color, Material = material, CFrame = CFrame.new(side * 1.3 * s, 0.1 * s, -0.9 * s), Parent = model })
			for k = -1, 1 do
				part({ Name = "Leg", Size = Vector3.new(0.9, 0.15, 0.15) * s, Color = color, Material = material, CFrame = CFrame.new(side * 1.2 * s, -0.2 * s, k * 0.45 * s) * CFrame.Angles(0, 0, side * 0.5), Parent = model })
			end
		end
	elseif fish.shape == "shrimp" then
		body = ovalPart({ Name = "Body", Size = Vector3.new(0.8, 0.8, 1.2) * s, Color = color, Material = material, CFrame = CFrame.new(), Parent = model })
		for k = 1, 3 do
			ovalPart({ Name = "Segment", Size = Vector3.new(0.7, 0.6, 0.6) * s * (1 - k * 0.15), Color = color, Material = material, CFrame = CFrame.new(0, -0.15 * k * s, (0.5 + 0.45 * k) * s), Parent = model })
		end
		for _, side in ipairs({ -1, 1 }) do
			part({ Name = "Antenna", Size = Vector3.new(0.08, 0.08, 1.4) * s, Color = color, CFrame = CFrame.new(side * 0.2 * s, 0.25 * s, -1.1 * s) * CFrame.Angles(0.3, side * 0.3, 0), Parent = model })
		end
	else
		body = ovalPart({ Name = "Body", Size = Vector3.new(0.8, 1.2, 2.4) * s, Color = color, Material = material, CFrame = CFrame.new(), Parent = model })
		part({ Name = "Tail", Size = Vector3.new(0.15, 1.1, 0.8) * s, Color = color, Material = material, CFrame = CFrame.new(0, 0, 1.4 * s), Parent = model })
		if fishKey == "CaKoi" and material ~= Enum.Material.Neon then
			ovalPart({ Name = "Spot", Size = Vector3.new(0.85, 0.6, 0.9) * s, Color = Color3.fromRGB(235, 90, 40), CFrame = CFrame.new(0, 0.25 * s, -0.2 * s), Parent = model })
		end
		for _, side in ipairs({ -1, 1 }) do
			part({ Name = "Eye", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.22 * s, Color = Color3.new(0.1, 0.1, 0.1), CFrame = CFrame.new(side * 0.33 * s, 0.15 * s, -0.8 * s), Parent = model })
		end
	end
	model.PrimaryPart = body
	return model
end

-- Nông sản (dùng cho cây trên ruộng và vật trưng bày). Tự chuyển sang mô hình cá nếu là thủy sản.
function Visuals.makeCrop(seedKey, mutKey, scale)
	if Config.Fish[seedKey] then
		return Visuals.makeFish(seedKey, mutKey, scale)
	end
	local seed = Config.Seeds[seedKey]
	local model = Instance.new("Model")
	model.Name = "Crop"
	local color, material, sizeMult = mutationLook(seed.color, mutKey)
	local s = 1.6 * scale * sizeMult
	local fruit = part({ Name = "Fruit", Shape = Enum.PartType.Ball, Size = Vector3.one * s, Color = color, Material = material, CFrame = CFrame.new(), Parent = model })
	part({ Name = "Leaf", Size = Vector3.new(s * 0.2, s * 0.5, s * 0.2), Color = Color3.fromRGB(60, 160, 60), CFrame = CFrame.new(0, s * 0.6, 0), Parent = model })
	model.PrimaryPart = fruit
	return model
end

Visuals.billboard = billboard
Visuals.part = part

return Visuals
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[-- Dựng toàn bộ map bằng code: nền, đường, 5 quầy hàng, 5 nông trại (ruộng + ao),
-- và 1 Nhà Triển Lãm chung chia 5 khu.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local WorldBuilder = {}

local PLOT_POSITIONS = {
	Vector3.new(-90, 0, -80), Vector3.new(0, 0, -80), Vector3.new(90, 0, -80),
	Vector3.new(-90, 0, 80), Vector3.new(90, 0, 80),
}
local HALL_POSITION = Vector3.new(0, 0, 85)
local GRID_COLS, GRID_ROWS = 6, 4

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	p.Parent = props.Parent
	return p
end

local function surfaceText(target, face, text, textColor, bg)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.Parent = target
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundColor3 = bg or Color3.fromRGB(60, 40, 25)
	lbl.BackgroundTransparency = bg and 0 or 1
	lbl.TextColor3 = textColor or Color3.new(1, 1, 1)
	lbl.TextScaled = true
	lbl.Font = Enum.Font.FredokaOne
	lbl.Text = text
	lbl.Parent = sg
	return lbl
end

local function makeNPC(parent, cf, shirt, name)
	local model = Instance.new("Model")
	model.Name = name
	local torso = part({ Name = "Torso", Size = Vector3.new(2, 2, 1), CFrame = cf * CFrame.new(0, 3, 0), Color = shirt, Parent = model })
	part({ Name = "Head", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), CFrame = cf * CFrame.new(0, 4.8, 0), Color = Color3.fromRGB(255, 220, 180), Parent = model })
	part({ Name = "Hat", Size = Vector3.new(2.2, 0.4, 2.2), CFrame = cf * CFrame.new(0, 5.6, 0), Color = Color3.fromRGB(230, 200, 120), Parent = model })
	part({ Name = "Legs", Size = Vector3.new(2, 2, 1), CFrame = cf * CFrame.new(0, 1, 0), Color = Color3.fromRGB(60, 70, 110), Parent = model })
	model.PrimaryPart = torso
	model.Parent = parent
	return model
end

local function makePrompt(parent, actionText, objectText, hold)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = parent
	return prompt
end

local function makeStall(parent, pos, title, color, panel, actionText)
	local folder = Instance.new("Model")
	folder.Name = panel -- tên cố định để hướng dẫn tìm được quầy
	local cf = CFrame.new(pos)
	part({ Name = "Floor", Size = Vector3.new(18, 1, 12), CFrame = cf * CFrame.new(0, 0.5, 0), Color = Color3.fromRGB(150, 110, 70), Material = Enum.Material.WoodPlanks, Parent = folder })
	local counter = part({ Name = "Counter", Size = Vector3.new(14, 3.5, 2), CFrame = cf * CFrame.new(0, 2.75, 0), Color = Color3.fromRGB(120, 80, 45), Material = Enum.Material.Wood, Parent = folder })
	for _, x in ipairs({ -8, 8 }) do
		for _, z in ipairs({ -5, 5 }) do
			part({ Size = Vector3.new(1, 10, 1), CFrame = cf * CFrame.new(x, 6, z), Color = Color3.fromRGB(100, 70, 40), Material = Enum.Material.Wood, Parent = folder })
		end
	end
	part({ Name = "Roof", Size = Vector3.new(20, 1, 14), CFrame = cf * CFrame.new(0, 11.5, 0), Color = color, Material = Enum.Material.Fabric, Parent = folder })
	local sign = part({ Name = "Sign", Size = Vector3.new(14, 3, 0.5), CFrame = cf * CFrame.new(0, 13.5, 0), Color = Color3.fromRGB(60, 40, 25), Parent = folder })
	surfaceText(sign, Enum.NormalId.Front, title, Color3.new(1, 1, 1))
	surfaceText(sign, Enum.NormalId.Back, title, Color3.new(1, 1, 1))
	makeNPC(folder, cf * CFrame.new(0, 1, -2.5) * CFrame.Angles(0, math.pi, 0), color, "NPC")

	local prompt = makePrompt(counter, actionText, title)
	prompt.MaxActivationDistance = 14
	prompt:SetAttribute("Panel", panel)
	folder.Parent = parent
	return folder
end

local function buildPlot(parent, index, origin)
	local cf = CFrame.lookAt(origin, Vector3.new(origin.X, 0, 0)) -- mặt trước (-Z) hướng ra đường chính
	local model = Instance.new("Model")
	model.Name = "Plot" .. index

	part({ Name = "Base", Size = Vector3.new(56, 1, 56), CFrame = cf * CFrame.new(0, 0.5, 0), Color = Color3.fromRGB(110, 75, 45), Material = Enum.Material.Ground, Parent = model })
	part({ Name = "PondArea", Size = Vector3.new(56, 0.2, 18), CFrame = cf * CFrame.new(0, 1.1, 18), Color = Color3.fromRGB(110, 170, 80), Material = Enum.Material.Grass, Parent = model })
	-- viền gỗ
	for _, info in ipairs({
		{ Vector3.new(58, 1.5, 1), Vector3.new(0, 1.25, -28.5) },
		{ Vector3.new(58, 1.5, 1), Vector3.new(0, 1.25, 28.5) },
		{ Vector3.new(1, 1.5, 56), Vector3.new(-28.5, 1.25, 0) },
		{ Vector3.new(1, 1.5, 56), Vector3.new(28.5, 1.25, 0) },
	}) do
		part({ Size = info[1], CFrame = cf * CFrame.new(info[2]), Color = Color3.fromRGB(140, 95, 55), Material = Enum.Material.WoodPlanks, Parent = model })
	end

	-- biển tên nông trại
	local signPost = part({ Name = "OwnerSign", Size = Vector3.new(16, 4, 0.5), CFrame = cf * CFrame.new(0, 4, -30.5), Color = Color3.fromRGB(60, 40, 25), Parent = model })
	local ownerLabel = surfaceText(signPost, Enum.NormalId.Front, "Nông trại trống", Color3.fromRGB(255, 240, 200))
	surfaceText(signPost, Enum.NormalId.Back, "Nông trại", Color3.fromRGB(255, 240, 200))

	-- ô đất (phía trước)
	local tilesFolder = Instance.new("Folder")
	tilesFolder.Name = "Tiles"
	tilesFolder.Parent = model
	local tiles = {}
	for r = 1, GRID_ROWS do
		for c = 1, GRID_COLS do
			local idx = (r - 1) * GRID_COLS + c
			local tileModel = Instance.new("Model")
			tileModel.Name = "Tile" .. idx
			local soil = part({
				Name = "Soil",
				Size = Vector3.new(7, 1, 7),
				CFrame = cf * CFrame.new(-20 + (c - 1) * 8, 1.3, -24 + (r - 1) * 8),
				Color = Color3.fromRGB(85, 55, 30),
				Material = Enum.Material.Mud,
				Parent = tileModel,
			})
			local click = Instance.new("ClickDetector")
			click.MaxActivationDistance = 45
			click.Parent = tileModel
			tileModel.PrimaryPart = soil
			tileModel.Parent = tilesFolder
			tiles[idx] = { model = tileModel, soil = soil, click = click }
		end
	end

	-- AO NUÔI THỦY SẢN (phía sau)
	local pondsFolder = Instance.new("Folder")
	pondsFolder.Name = "Ponds"
	pondsFolder.Parent = model
	local ponds = {}
	local sign = part({ Name = "PondSign", Size = Vector3.new(14, 2.4, 0.4), CFrame = cf * CFrame.new(0, 3, 9.2), Color = Color3.fromRGB(40, 90, 140), Parent = model })
	surfaceText(sign, Enum.NormalId.Front, "🐟 Ao Nuôi Thủy Sản", Color3.new(1, 1, 1))
	for i = 1, Config.PondCount do
		local pondModel = Instance.new("Model")
		pondModel.Name = "Pond" .. i
		local pcf = cf * CFrame.new(-21 + (i - 1) * 14, 0, 19)
		local rim = part({ Name = "Rim", Size = Vector3.new(12.5, 1.6, 12), CFrame = pcf * CFrame.new(0, 1.6, 0), Color = Color3.fromRGB(150, 150, 140), Material = Enum.Material.Cobblestone, Parent = pondModel })
		local water = part({
			Name = "Water",
			Size = Vector3.new(10.5, 0.4, 10),
			CFrame = pcf * CFrame.new(0, 2.3, 0),
			Color = Color3.fromRGB(70, 150, 200),
			Material = Enum.Material.Glass,
			Transparency = 0.25,
			CanCollide = false,
			Parent = pondModel,
		})
		local click = Instance.new("ClickDetector")
		click.MaxActivationDistance = 45
		click.Parent = pondModel
		pondModel.PrimaryPart = rim
		pondModel.Parent = pondsFolder
		ponds[i] = { model = pondModel, water = water, rim = rim, click = click }
	end

	model.Parent = parent

	return {
		index = index,
		cframe = cf,
		model = model,
		tiles = tiles,
		ponds = ponds,
		ownerLabel = ownerLabel,
		spawnCFrame = cf * CFrame.new(0, 4, -35) * CFrame.Angles(0, math.pi, 0),
		owner = nil,
	}
end

-- NHÀ TRIỂN LÃM CHUNG: 5 khu, mỗi khu thuộc về 1 nông trại
local function buildHall(parent, sectionCount)
	local hcf = CFrame.lookAt(HALL_POSITION, Vector3.new(HALL_POSITION.X, 0, 0))
	local house = Instance.new("Model")
	house.Name = "ExhibitionHall"
	local width, depth = 86, 32
	local wallColor = Color3.fromRGB(250, 245, 235)
	part({ Name = "Floor", Size = Vector3.new(width, 1, depth), CFrame = hcf * CFrame.new(0, 0.5, 0), Color = Color3.fromRGB(235, 225, 205), Material = Enum.Material.Marble, Parent = house })
	part({ Name = "Carpet", Size = Vector3.new(width - 4, 0.1, 6), CFrame = hcf * CFrame.new(0, 1.05, -8), Color = Color3.fromRGB(170, 40, 50), Material = Enum.Material.Fabric, Parent = house })
	part({ Name = "BackWall", Size = Vector3.new(width, 16, 1), CFrame = hcf * CFrame.new(0, 9, depth / 2 - 0.5), Color = wallColor, Parent = house })
	part({ Name = "LeftWall", Size = Vector3.new(1, 16, depth), CFrame = hcf * CFrame.new(-width / 2 + 0.5, 9, 0), Color = wallColor, Parent = house })
	part({ Name = "RightWall", Size = Vector3.new(1, 16, depth), CFrame = hcf * CFrame.new(width / 2 - 0.5, 9, 0), Color = wallColor, Parent = house })
	part({ Name = "Roof", Size = Vector3.new(width + 3, 1, depth + 3), CFrame = hcf * CFrame.new(0, 17.5, 0), Color = Color3.fromRGB(170, 50, 50), Material = Enum.Material.Slate, Parent = house })
	for k = 0, 6 do
		local x = -width / 2 + 0.8 + k * (width - 1.6) / 6
		part({ Size = Vector3.new(1.6, 17, 1.6), CFrame = hcf * CFrame.new(x, 9, -depth / 2), Color = Color3.fromRGB(200, 170, 90), Material = Enum.Material.Marble, Parent = house })
	end
	local banner = part({ Name = "Banner", Size = Vector3.new(40, 3.5, 0.5), CFrame = hcf * CFrame.new(0, 15.2, -depth / 2 - 0.3), Color = Color3.fromRGB(170, 50, 50), Parent = house })
	surfaceText(banner, Enum.NormalId.Front, "🏛 Nhà Triển Lãm Chung", Color3.fromRGB(255, 230, 150))

	local sections = {}
	local secW = (width - 2) / sectionCount
	for i = 1, sectionCount do
		local sx = -width / 2 + 1 + secW * (i - 0.5)
		local scf = hcf * CFrame.new(sx, 0, 0)
		if i > 1 then
			part({ Name = "Divider", Size = Vector3.new(0.6, 5, 14), CFrame = hcf * CFrame.new(-width / 2 + 1 + secW * (i - 1), 3.5, 7), Color = Color3.fromRGB(200, 170, 90), Material = Enum.Material.Marble, Parent = house })
		end
		local nameBoard = part({ Name = "NameBoard" .. i, Size = Vector3.new(secW - 2, 3, 0.4), CFrame = scf * CFrame.new(0, 11, depth / 2 - 1.2), Color = Color3.fromRGB(60, 40, 25), Parent = house })
		local nameLabel = surfaceText(nameBoard, Enum.NormalId.Front, "Khu " .. i .. " • trống", Color3.fromRGB(255, 240, 200))
		local likeBoard = part({ Name = "LikeBoard" .. i, Size = Vector3.new(secW - 6, 1.6, 0.4), CFrame = scf * CFrame.new(0, 8.6, depth / 2 - 1.2), Color = Color3.fromRGB(60, 40, 25), Parent = house })
		local likeLabel = surfaceText(likeBoard, Enum.NormalId.Front, "❤ 0", Color3.fromRGB(255, 150, 170))
		local likeStand = part({ Name = "LikeStand" .. i, Size = Vector3.new(2, 3, 2), CFrame = scf * CFrame.new(0, 2.5, -4), Color = Color3.fromRGB(255, 150, 170), Material = Enum.Material.SmoothPlastic, Parent = house })
		local likePrompt = makePrompt(likeStand, "Thích khu này ❤", "Khu " .. i, 0.3)

		local pedestals = {}
		local pedCount = Config.ExhibitSlots
		for j = 1, pedCount do
			local px = (j - (pedCount + 1) / 2) * (secW / pedCount)
			local ped = part({
				Name = "Pedestal" .. i .. "_" .. j,
				Size = Vector3.new(4, 3, 4),
				CFrame = scf * CFrame.new(px, 2.5, 7),
				Color = Color3.fromRGB(215, 190, 120),
				Material = Enum.Material.Marble,
				Parent = house,
			})
			local light = Instance.new("SpotLight")
			light.Face = Enum.NormalId.Top
			light.Brightness = 2
			light.Range = 10
			light.Parent = ped
			pedestals[j] = ped
		end
		sections[i] = { nameLabel = nameLabel, likeLabel = likeLabel, likePrompt = likePrompt, pedestals = pedestals }
	end
	house.Parent = parent
	return sections
end

function WorldBuilder.build()
	local world = Instance.new("Folder")
	world.Name = "World"
	world.Parent = workspace

	local sand = Color3.fromRGB(210, 190, 150)
	part({ Name = "Ground", Size = Vector3.new(420, 2, 360), CFrame = CFrame.new(0, -1, 0), Color = Color3.fromRGB(100, 175, 70), Material = Enum.Material.Grass, Parent = world })
	part({ Name = "Road", Size = Vector3.new(300, 0.2, 24), CFrame = CFrame.new(0, 0.1, 0), Color = sand, Material = Enum.Material.Sand, Parent = world })
	for _, pos in ipairs(PLOT_POSITIONS) do
		local zMid = pos.Z > 0 and 32 or -32
		part({ Size = Vector3.new(10, 0.2, 40), CFrame = CFrame.new(pos.X, 0.1, zMid), Color = sand, Material = Enum.Material.Sand, Parent = world })
	end
	part({ Size = Vector3.new(12, 0.2, 58), CFrame = CFrame.new(0, 0.1, 41), Color = sand, Material = Enum.Material.Sand, Parent = world })

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(0, 0.5, 0)
	spawn.Color = Color3.fromRGB(255, 230, 150)
	spawn.Material = Enum.Material.Neon
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = world

	local shops = Instance.new("Folder")
	shops.Name = "Shops"
	shops.Parent = world
	makeStall(shops, Vector3.new(-125, 0, 0), "🐾 Cửa Hàng Pet", Color3.fromRGB(230, 120, 60), "PetShop", "Mua pet")
	makeStall(shops, Vector3.new(-60, 0, 0), "🛠 Dụng Cụ", Color3.fromRGB(80, 140, 230), "GearShop", "Mua dụng cụ")
	makeStall(shops, Vector3.new(-25, 0, 0), "🌱 Hạt Giống", Color3.fromRGB(80, 180, 80), "SeedShop", "Mua hạt giống")
	makeStall(shops, Vector3.new(25, 0, 0), "🐟 Thủy Sản", Color3.fromRGB(40, 150, 200), "FishShop", "Mua con giống")
	makeStall(shops, Vector3.new(60, 0, 0), "💰 Bán Hàng", Color3.fromRGB(230, 190, 50), "Sell", "Bán nông sản, thủy sản")

	-- cây trang trí (tránh nông trại, nhà triển lãm và đường)
	local function blocked(x, z)
		if math.abs(z) < 16 then
			return true
		end
		for _, pos in ipairs(PLOT_POSITIONS) do
			if math.abs(x - pos.X) < 36 and math.abs(z - pos.Z) < 40 and math.sign(z) == math.sign(pos.Z) then
				return true
			end
			if math.abs(x - pos.X) < 9 and math.abs(z) < 56 then
				return true
			end
		end
		return math.abs(x - HALL_POSITION.X) < 52 and z > 10
	end
	local rng = Random.new(42)
	for _ = 1, 50 do
		local x = rng:NextNumber(-200, 200)
		local z = rng:NextNumber(-170, 170)
		if not blocked(x, z) then
			part({ Name = "Trunk", Size = Vector3.new(1.5, 8, 1.5), CFrame = CFrame.new(x, 4, z), Color = Color3.fromRGB(110, 75, 40), Material = Enum.Material.Wood, Parent = world })
			part({ Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.new(8, 8, 8), CFrame = CFrame.new(x, 10, z), Color = Color3.fromRGB(60, 140, 60), Material = Enum.Material.Grass, Parent = world })
		end
	end

	Lighting.ClockTime = 14
	Lighting.Brightness = 2.5
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)

	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = world
	local plots = {}
	for i, pos in ipairs(PLOT_POSITIONS) do
		plots[i] = buildPlot(plotsFolder, i, pos)
	end
	local sections = buildHall(world, #PLOT_POSITIONS)
	return plots, sections
end

WorldBuilder.GRID_SIZE = GRID_COLS * GRID_ROWS

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="11">
